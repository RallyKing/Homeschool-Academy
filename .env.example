# Convex deployment URL (written by `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=https://YOUR_DEPLOYMENT.convex.cloud

# Convex HTTP actions / Auth site URL (written by `npx convex dev`)
NEXT_PUBLIC_CONVEX_SITE_URL=https://YOUR_DEPLOYMENT.convex.site

# App URL for Convex Auth redirects
# Local: http://localhost:3000
# Production: https://homeschool-academy.vercel.app
SITE_URL=http://localhost:3000

# These are set on the Convex deployment (dashboard or `npx @convex-dev/auth`),
# not usually in Next.js .env — listed here for reference:
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY----- ..."
# JWKS={"keys":[...]}
# SITE_URL=http://localhost:3000
